FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY artifacts/releases/banking77 ./artifacts/releases/banking77
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 appuser
USER appuser
EXPOSE 8000
ENV MODEL_BUNDLE_PATH=/app/artifacts/releases/banking77
CMD ["sh", "-c", "exec uvicorn triagedesk.serving.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
