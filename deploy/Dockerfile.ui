FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY ui ./ui
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 appuser
USER appuser
EXPOSE 8501
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)"
CMD ["sh", "-c", "exec streamlit run ui/app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
